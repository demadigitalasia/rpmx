# Contoh env produksi RPMX — salin ke .env di server (file .env asli JANGAN di-commit;
# .gitignore memblokir .env* dan hanya mengecualikan file contoh ini).
# Validasi otomatis sebelum deploy: npm run check:prod

# Koneksi PostgreSQL produksi — WAJIB password kuat, bukan password dev lokal.
DATABASE_URL=postgres://rpmx:GANTI-DENGAN-PASSWORD-KUAT@localhost:5432/rpmx

# URL publik situs — dipakai metadata/OG, sitemap, robots, dan format WA.
NEXT_PUBLIC_SITE_URL=https://domainanda.com

# Password login /admin — WAJIB kuat (min. 8 karakter, bukan admin123/changeme).
# Di produksi, password lemah membuat halaman admin terkunci dan login gagal cepat
# (validateProdEnv di src/lib/env-check.ts). Simpan juga di password manager.
ADMIN_PASSWORD=ganti-dengan-password-kuat
